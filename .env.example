# Copy this file to .env and adjust values as needed.

OLLAMA_HOST=http://localhost:11434

# Coding ke liye qwen2.5-coder:7b kaafi behtar hai (par dheema)
OLLAMA_MODEL=llama3.2:3b

# Ollama tak pahunchne ka timeout (seconds)
OLLAMA_CONNECT_TIMEOUT=10

# Do tokens ke beech max gap — lamba jawab chalta rahega, par Ollama chup ho
# jaye toh request hamesha ke liye nahi latkegi
OLLAMA_READ_TIMEOUT=60

# Claude ka ek jawab max kitna lamba — ye cost cap hai, API par har token ke
# paise lagte hain. Anthropic API key yahan NAHI aati: wo UI ke Settings mein
# daali jaati hai aur browser mein hi rehti hai.
ANTHROPIC_MAX_TOKENS=8192

DATABASE_URL=postgresql://ai_user:ai_password@localhost/ai_assistant

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Ek chat message max kitna lamba ho sakta hai (characters)
MAX_MESSAGE_LENGTH=4000

# Context ke liye pichhle kitne messages LLM ko bhejne hain
HISTORY_MESSAGE_LIMIT=20

# Kaun se frontend origins API ko call kar sakte hain (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Auth ─────────────────────────────────────────────────────────────────
# Default off — local single-user app par login wall ka koi matlab nahi.
# Deploy karte waqt true karo; tab har user sirf apni chats dekhega.
AUTH_ENABLED=false
SESSION_TTL_DAYS=30

# ─── Rate limiting ────────────────────────────────────────────────────────
# Chat endpoints par per-client limit. 0 karne par band ho jaati hai.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# Sidebar ek baar mein kitni conversations maange
CONVERSATION_PAGE_SIZE=50

# Context ka character budget (roughly 4 chars = 1 token)
HISTORY_CHAR_BUDGET=16000
